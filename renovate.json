{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(build)"
  ],
  "labels": ["type:build", "scope:deps"], 
  "packageRules": [
    {
      "matchPackageNames": ["@crystal-creations/crystal-components"],
      "followTag": "beta"
    },
    {
      "matchDepTypes": ["devDependencies", "dev-dependencies", "dev"],
      "semanticCommitScope": "deps-dev",
      "labels": ["type:build", "scope:deps-dev"], 
    }
  ]
}
