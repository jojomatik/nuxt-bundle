{
  "name": "@jojomatik/nuxt-bundle",
  "version": "2.0.0-beta.25",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "description": "A bundle of commonly used nuxt dependencies and configuration.",
  "keywords": [
    "nuxt",
    "bundle",
    "config",
    "dependencies",
    "configuration"
  ],
  "scripts": {
    "prepare": "nuxi prepare",
    "dev": "nuxi dev",
    "build": "nuxi build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "semantic-release": "semantic-release"
  },
  "files": [
    "app",
    "lib",
    "locales",
    "modules",
    "nuxt.config.ts",
    "package.json",
    "README.md",
    "vuetify-options.ts"
  ],
  "main": "nuxt.config.ts",
  "dependencies": {
    "@crystal-creations/crystal-components": "1.0.0-beta.49",
    "@fontsource/roboto": "5.3.0",
    "@mdi/js": "7.4.47",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "2.2.0",
    "@nuxtjs/i18n": "10.2.1",
    "@nuxtjs/seo": "5.3.16",
    "@nuxtjs/storybook": "10.0.3",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-links": "10.6.5",
    "@types/node": "24.19.2",
    "chromatic": "18.13.3",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.7.4",
    "rollup": "4.65.1",
    "rollup-plugin-license": "3.7.1",
    "sass": "1.106.1",
    "semantic-release": "25.0.9",
    "storybook": "10.6.5",
    "typescript": "6.0.3",
    "vue-router": "5.4.0",
    "vuetify": "3.13.7",
    "vuetify-nuxt-module": "1.0.0-rc.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "happy-dom": "21.0.4",
    "nuxt": "4.6.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  },
  "peerDependencies": {
    "eslint": "^9.39.2 || ^10.0.0",
    "nuxt": "^4.2.2",
    "vite": "^7.3.0 || ^8.0.0",
    "vue": "^3.5.26"
  },
  "author": {
    "name": "jojomatik",
    "email": "dev@jojomatik.de"
  },
  "bugs": {
    "url": "https://github.com/jojomatik/nuxt-bundle/issues",
    "email": "dev@jojomatik.de"
  },
  "homepage": "https://github.com/jojomatik/nuxt-bundle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jojomatik/nuxt-bundle.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
